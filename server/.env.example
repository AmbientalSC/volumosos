PORT=3001

# Postgres — instância já existente na VPS, schema "operação" (ver plano de migração)
DATABASE_URL=postgresql://controladoria:CHANGE_ME@internal-host:5432/controladoria_cache

# MinIO (S3-compatible), serviço próprio no Coolify
MINIO_ENDPOINT=vol-minio.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=volumosos
MINIO_PUBLIC_BASE_URL=https://vol-media.ambiental.dev.br

# Firebase Auth (verificação de token) — projeto original do app
FIREBASE_PROJECT_ID=volumosos-d6369
# JSON da service account, em base64 (nunca em texto puro / nunca commitado)
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=CHANGE_ME

# Origens permitidas por CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=https://vol.ambiental.dev.br,https://localhost,capacitor://localhost,http://localhost:3000
